{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own commands and nothing else: no file system, shell, opener or window APIs.",
  "windows": ["main"],
  "permissions": [
    "allow-scan",
    "allow-install",
    "allow-list-generated",
    "allow-remove",
    "allow-prefixes",
    "allow-check-update",
    "allow-install-update"
  ]
}
