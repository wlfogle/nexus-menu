# Launcher for nexus-menu itself.
#
# This file is hand-written and carries no X-NexusMenu-Generated marker, so
# `nexus-menu remove` will never delete it.
#
# Exec calls the binary by name, which requires it to be on the $PATH of the
# desktop session. `make install` rewrites Exec and TryExec to the absolute
# path the binary was installed to, which removes that requirement.
#
# Every command is wrapped in `sh -c` so the terminal window stays open after
# the tool exits; otherwise the emulator closes instantly and the summary is
# never read.
[Desktop Entry]
Type=Application
Version=1.0
Name=Menu Entry Finder
GenericName=Desktop Entry Generator
Comment=Find installed applications with no menu entry and create one
Exec=sh -c "nexus-menu install; echo; echo 'Press Enter to close this window.'; read done"
TryExec=nexus-menu
Icon=nexus-menu
Terminal=true
Categories=Settings;DesktopSettings;
Keywords=application;menu;launcher;desktop entry;freedesktop;xdg;kappfinder;missing;
StartupNotify=false
Actions=scan;orphans;remove;

[Desktop Action scan]
Name=Scan without changing anything
Exec=sh -c "nexus-menu scan; echo; echo 'Press Enter to close this window.'; read done"

[Desktop Action orphans]
Name=List every binary with no menu entry
Exec=sh -c "nexus-menu orphans; echo; echo 'Press Enter to close this window.'; read done"

[Desktop Action remove]
Name=Remove the entries this tool created
Exec=sh -c "nexus-menu remove; echo; echo 'Press Enter to close this window.'; read done"
